# Managed by PulseDeck deploy_hub.sh
[Unit]
Description=PulseDeck privileged updater
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3
ConditionPathExists=/var/lib/pulsedeck-updater/inbox/request.json

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/pulsedeck-updater
UMask=0027
PrivateTmp=true
ProtectHome=true
