# Template only. Runtime user and installation path are intentionally unresolved.
[Unit]
Description=PulseDeck Hub
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=@PULSEDECK_USER@
WorkingDirectory=@PULSEDECK_ROOT@
ExecStart=@PULSEDECK_VENV@/bin/pulsedeck-hub
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
