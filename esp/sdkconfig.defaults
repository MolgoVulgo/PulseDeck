CONFIG_IDF_TARGET="esp32s3"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# esp-010 experiment: PSRAM bus at 80 MHz. Must also be enabled in existing sdkconfig.
CONFIG_SPIRAM_SPEED_80M=y
# ESP03: runtime par tache et identification du temps IDLE sur chaque coeur.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
# test_001: LVGL 9.5 SVG decoder + SVG animation attribute parsing, SW vector backend.
CONFIG_LV_USE_VECTOR_GRAPHIC=y
CONFIG_LV_USE_MATRIX=y
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_THORVG=y
CONFIG_LV_USE_THORVG_INTERNAL=y
CONFIG_LV_USE_SVG=y
CONFIG_LV_USE_SVG_ANIMATION=y
# test_001-2: allow a 2 MiB LVGL TLSF pool in external PSRAM.
CONFIG_LV_MEM_POOL_EXPAND_SIZE_KILOBYTES=2048
# test_002: built-in Lottie widget needs Canvas, ThorVG and vector backend.
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_LOTTIE=y

# test_002: Lottie/ThorVG exceeds the default 1 MiB application partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
