pkgname=pulsedeck-agent
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='Machine-local metrics agent for PulseDeck'
arch=('any')
url='https://github.com/MolgoVulgo/PulseDeck'
depends=('python' 'python-psutil' 'python-pyyaml' 'systemd')
makedepends=('git')
backup=('etc/pulsedeck-agent/agent.yml')

_pulsedeck_ref="${PULSEDECK_REF:-main}"
_pulsedeck_commit="${PULSEDECK_COMMIT:-}"
case "$_pulsedeck_ref" in
    main|dev) ;;
    *) printf 'Unsupported PULSEDECK_REF: %s\n' "$_pulsedeck_ref" >&2; return 1 ;;
esac
if [[ -n "$_pulsedeck_commit" && ! "$_pulsedeck_commit" =~ ^[0-9a-f]{40}$ ]]; then
    printf 'Invalid PULSEDECK_COMMIT: %s\n' "$_pulsedeck_commit" >&2
    return 1
fi

if [[ -n "$_pulsedeck_commit" ]]; then
    source=("PulseDeck::git+https://github.com/MolgoVulgo/PulseDeck.git#commit=${_pulsedeck_commit}")
else
    source=("PulseDeck::git+https://github.com/MolgoVulgo/PulseDeck.git#branch=${_pulsedeck_ref}")
fi
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/PulseDeck"
    printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
    cd "$srcdir/PulseDeck"

    install -d "$pkgdir/usr/lib/pulsedeck-agent"
    cp -a agent/src/pulsedeck_agent "$pkgdir/usr/lib/pulsedeck-agent/"

    install -d "$pkgdir/usr/bin"
    cat > "$pkgdir/usr/bin/pulsedeck-agent" <<'WRAPPER'
#!/bin/sh
export PYTHONPATH="/usr/lib/pulsedeck-agent${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python -m pulsedeck_agent "$@"
WRAPPER
    chmod 0755 "$pkgdir/usr/bin/pulsedeck-agent"

    install -Dm0644 agent/config/pulsedeck-agent.example.yml \
        "$pkgdir/etc/pulsedeck-agent/agent.yml"
    install -Dm0644 agent/systemd/pulsedeck-agent.service \
        "$pkgdir/usr/lib/systemd/system/pulsedeck-agent.service"
    install -Dm0644 agent/systemd/pulsedeck-agent.sysusers \
        "$pkgdir/usr/lib/sysusers.d/pulsedeck-agent.conf"
    install -Dm0755 agent/scripts/prepare-state.sh \
        "$pkgdir/usr/libexec/pulsedeck-agent/prepare-state.sh"
    install -Dm0755 agent/scripts/update.sh \
        "$pkgdir/usr/libexec/pulsedeck-agent/update.sh"

    install -d "$pkgdir/usr/share/pulsedeck-agent"
    printf '%s\n' 'arch-package' > "$pkgdir/usr/share/pulsedeck-agent/install-method"
    printf '%s\n' "$_pulsedeck_ref" > "$pkgdir/usr/share/pulsedeck-agent/source-ref"
    git rev-parse HEAD > "$pkgdir/usr/share/pulsedeck-agent/source-revision"
    install -Dm0644 agent/packaging/arch/PKGBUILD \
        "$pkgdir/usr/share/pulsedeck-agent/arch/PKGBUILD"
    install -Dm0755 agent/packaging/arch/install.sh \
        "$pkgdir/usr/share/pulsedeck-agent/arch/install.sh"

    install -Dm0644 agent/README.md \
        "$pkgdir/usr/share/doc/pulsedeck-agent/README.md"
    install -Dm0644 agent/README.fr.md \
        "$pkgdir/usr/share/doc/pulsedeck-agent/README.fr.md"
    install -Dm0644 agent/docs/INSTALL.md \
        "$pkgdir/usr/share/doc/pulsedeck-agent/INSTALL.md"
    install -Dm0644 agent/docs/fr/INSTALL.md \
        "$pkgdir/usr/share/doc/pulsedeck-agent/INSTALL.fr.md"
}
